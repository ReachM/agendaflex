generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusinessSegment {
  CLINICA_MEDICA
  OFICINA_MECANICA
  SALAO_BELEZA
  CONSULTORIO
  ASSISTENCIA_TECNICA
  PRESTADOR_SERVICOS
  PERSONALIZADO
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleName {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  STAFF
  USER
}

enum RoleScope {
  SYSTEM
  TENANT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EntityType {
  CUSTOMER
  SERVICE
  PROFESSIONAL
  APPOINTMENT
}

enum CustomFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  MONEY
  PERCENT
  DATE
  TIME
  DATETIME
  SINGLE_SELECT
  MULTI_SELECT
  CHECKBOX
  BOOLEAN
  EMAIL
  PHONE
  CPF_CNPJ
  FILE
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  TRANSFER
  OTHER
}

enum InvoiceStatus {
  NOT_REQUESTED
  REQUESTED
  UNDER_REVIEW
  ISSUED
  SENT_TO_CUSTOMER
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum FinancialRecordType {
  REVENUE
  DISCOUNT
  REFUND
  ADJUSTMENT
}

enum AppointmentSource {
  INTERNAL
  PUBLIC_LINK
  BOT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELED
  APPOINTMENT_STARTED
  APPOINTMENT_COMPLETED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PatientOrigin {
  INDICACAO
  INSTAGRAM
  GOOGLE
  WHATSAPP
  PRESENCIAL
  OUTRO
}

enum BotConversationStep {
  IDLE
  AWAITING_SERVICE
  AWAITING_DATE
  AWAITING_SLOT
  AWAITING_NAME
}

// ═══════════════════════════════════════════════════
// PLANS & SUBSCRIPTIONS
// ═══════════════════════════════════════════════════

model Plan {
  id                                  String   @id @default(cuid())
  name                                String
  slug                                String   @unique
  description                         String?
  price                               Decimal  @default(0) @db.Decimal(12, 2)
  maxUsers                            Int      @default(3)
  maxProfessionals                    Int      @default(5)
  maxCustomers                        Int      @default(100)
  maxAppointmentsPerMonth             Int      @default(200)
  allowClientSelfScheduling           Boolean  @default(false)
  allowAdvancedReports                Boolean  @default(false)
  allowFinancialControl               Boolean  @default(false)
  allowInvoiceRequest                 Boolean  @default(false)
  allowCustomerChecklist              Boolean  @default(false)
  allowAuditLogs                      Boolean  @default(true)
  allowCustomFields                   Boolean  @default(true)
  allowMultipleServicesPerAppointment Boolean  @default(true)
  allowBotIntegration                 Boolean  @default(false)
  isActive                            Boolean  @default(true)
  sortOrder                           Int      @default(0)
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  features      PlanFeature[]
  subscriptions CompanySubscription[]

  @@index([isActive])
}

model PlanFeature {
  id          String   @id @default(cuid())
  planId      String
  featureKey  String
  featureName String
  enabled     Boolean  @default(true)
  limitValue  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([planId])
}

model CompanySubscription {
  id          String             @id @default(cuid())
  companyId   String
  planId      String
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime           @default(now())
  endsAt      DateTime?
  trialEndsAt DateTime?
  canceledAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([planId])
}

// ═══════════════════════════════════════════════════
// COMPANY
// ═══════════════════════════════════════════════════

model Company {
  id                   String          @id @default(cuid())
  name                 String
  tradeName            String?
  document             String?
  email                String
  phone                String?
  slug                 String?         @unique
  segment              BusinessSegment @default(PERSONALIZADO)
  status               CompanyStatus   @default(ACTIVE)
  plan                 String          @default("starter")
  publicBookingEnabled Boolean         @default(false)
  autoConfirmBooking   Boolean         @default(false)
  settings             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  users                 CompanyUser[]
  customers             Customer[]
  services              Service[]
  professionals         Professional[]
  appointments          Appointment[]
  appointmentServices   AppointmentService[]
  customFields          CustomField[]
  fieldValues           CustomFieldValue[]
  auditLogs             AuditLog[]
  subscriptions         CompanySubscription[]
  financialRecords      FinancialRecord[]
  invoiceRequests       InvoiceRequest[]
  checklists            Checklist[]
  checklistItems        ChecklistItem[]
  customerCopies        CustomerCopy[]
  bookingSettings       PublicBookingSettings?
  notificationLogs      NotificationLog[]
  botConfiguration      CompanyBotConfig?
  botConversationStates BotConversationState[]

  // Liga/desliga do bot — fonte única de verdade. Reaproveitado pelo bot Evolution API.
  botEnabled Boolean @default(false)

  // @deprecated Campos da antiga integração via ChatBot Service (microsserviço externo).
  // Serão removidos quando as rotas/cliente do microsserviço forem retirados
  // (decisão: substituir pelo bot in-process via Evolution API). Mantidos por ora
  // para não quebrar o código existente. Não migrar dados.
  botApiKey        String?   @unique
  botWebhookSecret String?
  botRegisteredAt  DateTime?
  botConfig        Json?

  @@index([status])
  @@index([segment])
  @@index([slug])
}

// ═══════════════════════════════════════════════════
// USERS & ROLES
// ═══════════════════════════════════════════════════

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  systemRoleId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  systemRole          Role?            @relation("SystemRole", fields: [systemRoleId], references: [id])
  memberships         CompanyUser[]
  createdAppointments Appointment[]    @relation("AppointmentCreatedBy")
  updatedAppointments Appointment[]    @relation("AppointmentUpdatedBy")
  auditLogs           AuditLog[]
  createdChecklists   Checklist[]
  invoiceRequests     InvoiceRequest[] @relation("InvoiceRequestedBy")

  @@index([status])
  @@index([systemRoleId])
}

model CompanyUser {
  id        String     @id @default(cuid())
  companyId String
  userId    String
  roleId    String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([roleId])
  @@index([status])
}

model Role {
  id          String    @id @default(cuid())
  name        RoleName  @unique
  scope       RoleScope
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users           User[]           @relation("SystemRole")
  companyUsers    CompanyUser[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ═══════════════════════════════════════════════════
// CUSTOMER (expanded for clinic/health segments)
// ═══════════════════════════════════════════════════

model Customer {
  id                    String    @id @default(cuid())
  companyId             String
  name                  String
  email                 String?
  phone                 String?
  whatsapp              String?
  cpf                   String?
  rg                    String?
  birthDate             DateTime?
  gender                String?
  notes                 String?
  status                String    @default("active")
  // Address fields
  zipCode               String?
  address               String?
  addressNumber         String?
  neighborhood          String?
  city                  String?
  state                 String?
  complement            String?
  // Health/Clinic fields (LGPD-sensitive)
  healthInsurance       String?
  healthInsuranceNumber String?
  bloodType             String?
  allergies             String?
  medications           String?
  preExistingConditions String?
  requiredCare          String?
  clinicalNotes         String?
  emergencyContact      String?
  emergencyPhone        String?
  legalGuardian         String?
  legalGuardianCpf      String?
  // Administrative
  origin                String?
  internalNotes         String?
  anonymizedAt          DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  financialRecords FinancialRecord[]
  invoiceRequests  InvoiceRequest[]
  notificationLogs NotificationLog[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, name])
  @@index([companyId, email])
  @@index([companyId, cpf])
}

// ═══════════════════════════════════════════════════
// SERVICE
// ═══════════════════════════════════════════════════

model Service {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  basePrice       Decimal? @db.Decimal(12, 2)
  durationMinutes Int      @default(60)
  isActive        Boolean  @default(true)
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  appointmentServices AppointmentService[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, name])
  @@index([companyId, isPublic])
}

// ═══════════════════════════════════════════════════
// PROFESSIONAL
// ═══════════════════════════════════════════════════

model Professional {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  email        String?
  phone        String?
  specialty    String?
  isActive     Boolean  @default(true)
  isPublic     Boolean  @default(true)
  workingHours Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, name])
  @@index([companyId, isPublic])
}

// ═══════════════════════════════════════════════════
// APPOINTMENT (evolved with source tracking + approval)
// ═══════════════════════════════════════════════════

model Appointment {
  id                 String            @id @default(cuid())
  companyId          String
  customerId         String
  serviceId          String?
  professionalId     String
  startAt            DateTime
  endAt              DateTime
  status             AppointmentStatus @default(SCHEDULED)
  notes              String?
  internalNotes      String?
  // Financial fields
  partsValue         Decimal?          @db.Decimal(12, 2)
  laborValue         Decimal?          @db.Decimal(12, 2)
  discountPercent    Decimal?          @db.Decimal(5, 2)
  discountValue      Decimal?          @db.Decimal(12, 2)
  totalValue         Decimal?          @db.Decimal(12, 2)
  paymentStatus      PaymentStatus?
  paymentMethod      PaymentMethod?
  paidAt             DateTime?
  // Status lifecycle tracking
  startedAt          DateTime?
  completedAt        DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  // Source tracking
  bookedByClient     Boolean           @default(false)
  source             AppointmentSource @default(INTERNAL)
  approvalStatus     ApprovalStatus    @default(APPROVED)
  publicBookingToken String?           @unique
  // Creator tracking
  createdById        String?
  updatedById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id])
  service             Service?             @relation(fields: [serviceId], references: [id])
  professional        Professional         @relation(fields: [professionalId], references: [id])
  createdBy           User?                @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  updatedBy           User?                @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id])
  appointmentServices AppointmentService[]
  financialRecords    FinancialRecord[]
  invoiceRequests     InvoiceRequest[]
  checklists          Checklist[]
  notificationLogs    NotificationLog[]
  sentReminders       SentReminder[]

  @@index([companyId])
  @@index([companyId, startAt])
  @@index([companyId, status])
  @@index([companyId, professionalId, startAt, endAt])
  @@index([customerId])
  @@index([serviceId])
  @@index([professionalId])
  @@index([companyId, paymentStatus])
  @@index([companyId, source])
  @@index([companyId, approvalStatus])
  @@index([publicBookingToken])
}

// ═══════════════════════════════════════════════════
// APPOINTMENT SERVICES (multi-service per appointment)
// ═══════════════════════════════════════════════════

model AppointmentService {
  id                  String   @id @default(cuid())
  companyId           String
  appointmentId       String
  serviceId           String
  serviceNameSnapshot String
  quantity            Int      @default(1)
  unitPrice           Decimal? @db.Decimal(12, 2)
  discountPercentage  Decimal? @db.Decimal(5, 2)
  totalPrice          Decimal? @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@index([companyId])
  @@index([appointmentId])
  @@index([serviceId])
}

// ═══════════════════════════════════════════════════
// FINANCIAL RECORDS
// ═══════════════════════════════════════════════════

model FinancialRecord {
  id                 String              @id @default(cuid())
  companyId          String
  appointmentId      String?
  customerId         String?
  type               FinancialRecordType @default(REVENUE)
  description        String?
  amount             Decimal             @db.Decimal(12, 2)
  discountAmount     Decimal?            @db.Decimal(12, 2)
  discountPercentage Decimal?            @db.Decimal(5, 2)
  paymentStatus      PaymentStatus       @default(PENDING)
  paymentMethod      PaymentMethod?
  paidAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, paymentStatus])
  @@index([companyId, createdAt])
  @@index([appointmentId])
  @@index([customerId])
}

// ═══════════════════════════════════════════════════
// INVOICE REQUESTS
// ═══════════════════════════════════════════════════

model InvoiceRequest {
  id                    String        @id @default(cuid())
  companyId             String
  appointmentId         String?
  customerId            String?
  requestedByUserId     String?
  legalName             String
  documentNumber        String
  email                 String?
  phone                 String?
  address               String?
  number                String?
  neighborhood          String?
  city                  String?
  state                 String?
  zipCode               String?
  municipalRegistration String?
  amount                Decimal       @db.Decimal(12, 2)
  status                InvoiceStatus @default(REQUESTED)
  invoiceNumber         String?
  issuedAt              DateTime?
  fileUrl               String?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  requestedBy User?        @relation("InvoiceRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([appointmentId])
  @@index([customerId])
}

// ═══════════════════════════════════════════════════
// CHECKLISTS & CUSTOMER COPIES
// ═══════════════════════════════════════════════════

model Checklist {
  id              String   @id @default(cuid())
  companyId       String
  appointmentId   String
  title           String
  notes           String?
  status          String   @default("draft")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment  Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdByUserId], references: [id])
  items        ChecklistItem[]
  customerCopy CustomerCopy?

  @@index([companyId])
  @@index([appointmentId])
}

model ChecklistItem {
  id          String   @id @default(cuid())
  companyId   String
  checklistId String
  description String
  isChecked   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([checklistId])
}

model CustomerCopy {
  id            String   @id @default(cuid())
  companyId     String
  appointmentId String
  checklistId   String   @unique
  content       Json?
  publicToken   String   @unique @default(cuid())
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([appointmentId])
  @@index([publicToken])
}

// ═══════════════════════════════════════════════════
// CUSTOM FIELDS
// ═══════════════════════════════════════════════════

model CustomField {
  id           String          @id @default(cuid())
  companyId    String
  entityType   EntityType
  label        String
  fieldKey     String
  fieldType    CustomFieldType
  isRequired   Boolean         @default(false)
  sortOrder    Int             @default(0)
  placeholder  String?
  helpText     String?
  options      Json?
  defaultValue Json?
  isActive     Boolean         @default(true)
  isPublic     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@unique([companyId, entityType, fieldKey])
  @@index([companyId])
  @@index([companyId, entityType, isActive])
  @@index([companyId, entityType, isPublic])
}

model CustomFieldValue {
  id            String     @id @default(cuid())
  companyId     String
  customFieldId String
  entityType    EntityType
  entityId      String
  value         Json
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([companyId, customFieldId, entityType, entityId])
  @@index([companyId])
  @@index([companyId, entityType, entityId])
  @@index([customFieldId])
}

// ═══════════════════════════════════════════════════
// PUBLIC BOOKING SETTINGS
// ═══════════════════════════════════════════════════

model PublicBookingSettings {
  id                        String   @id @default(cuid())
  companyId                 String   @unique
  enabled                   Boolean  @default(false)
  publicSlug                String?  @unique
  requireManualApproval     Boolean  @default(false)
  allowChooseProfessional   Boolean  @default(true)
  minNoticeHours            Int      @default(1)
  maxDaysAhead              Int      @default(30)
  slotIntervalMinutes       Int      @default(30)
  instructions              String?
  confirmationMessage       String?
  sendEmailNotifications    Boolean  @default(true)
  sendWhatsappNotifications Boolean  @default(false)
  sendSmsNotifications      Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([publicSlug])
}

// ═══════════════════════════════════════════════════
// NOTIFICATION LOGS
// ═══════════════════════════════════════════════════

model NotificationLog {
  id            String              @id @default(cuid())
  companyId     String
  appointmentId String?
  customerId    String?
  channel       NotificationChannel
  type          NotificationType
  recipient     String
  subject       String?
  body          String?
  status        NotificationStatus  @default(PENDING)
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, status])
  @@index([appointmentId])
  @@index([customerId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════
// BOT WEBHOOK EVENTS (idempotency)
// ═══════════════════════════════════════════════════

model BotWebhookEvent {
  id        String   @id @default(cuid())
  companyId String
  eventId   String
  event     String
  payload   Json?
  createdAt DateTime @default(now())

  @@unique([companyId, eventId])
  @@index([companyId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════
// BOT (Evolution API — configuração, estado e lembretes)
// ═══════════════════════════════════════════════════

model CompanyBotConfig {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  whatsappInstance   String?
  allowBooking       Boolean  @default(false)
  faqConfig          Json     @default("[]") // [{pergunta, resposta}]
  reminderConfig     Json     @default("{}") // {enabled, send24h, send2h}
  businessHours      String?
  cancellationPolicy String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model BotConversationState {
  id        String              @id @default(cuid())
  companyId String
  phone     String
  step      BotConversationStep @default(IDLE)
  context   Json                @default("{}")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, phone])
  @@index([companyId])
}

model SentReminder {
  id            String   @id @default(cuid())
  appointmentId String
  type          String // "24h" | "2h"
  sentAt        DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, type])
  @@index([appointmentId])
}
