# ─── Banco ─────────────────────────────────────────────────────────
# String de conexão Postgres usada pelo Prisma.
# Em dev (docker-compose): postgresql://agendaflex:agendaflex@localhost:5433/agendaflex
# Em prod: ajuste host/porta/credenciais.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agendaflex"

# ─── Auth ──────────────────────────────────────────────────────────
# Segredo para assinar o JWT de sessão (HS256). MÍNIMO 32 chars aleatórios.
# Gere com: openssl rand -hex 32
# Sem isso definido em produção, o servidor LANÇA na primeira request.
AUTH_SECRET=""

# ─── URL pública da aplicação ──────────────────────────────────────
# Base absoluta usada em links gerados no backend (redefinição de senha,
# link público de agendamento). Em prod: https://marcaiflex.com.br
# Se ausente, o fluxo de reset cai para a origem da requisição.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── E-mail transacional (Resend) ──────────────────────────────────
# API key do Resend (re_...). Sem ela, sendEmail apenas loga (modo dev).
RESEND_API_KEY=""
# Remetente verificado no Resend (ex.: noreply@seudominio.com.br).
RESEND_FROM_EMAIL="noreply@marcaiflex.com.br"

# ─── Mercado Pago (gateway de pagamento) ───────────────────────────
# Access token do MP (APP_USR-... em produção, TEST-... em sandbox).
MP_ACCESS_TOKEN=""
# Segredo configurado no painel do MP — usado para validar o header
# x-signature em /api/webhooks/mercadopago.
MP_WEBHOOK_SECRET=""
# URL absoluta para a qual o MP redireciona o cliente após autorizar
# ou cancelar a assinatura (ex.: https://app.seudominio.com/assinatura).
MP_BACK_URL=""

# ─── Bot WhatsApp (Evolution API) ──────────────────────────────────
# Endpoint da Evolution API que envia/recebe mensagens.
EVOLUTION_API_URL=""
# API key da Evolution.
EVOLUTION_API_KEY=""
# Token validado em /api/webhooks/whatsapp (header x-webhook-token).
WHATSAPP_WEBHOOK_TOKEN=""
