# ─── Banco ─────────────────────────────────────────────────────────
# String de conexão Postgres usada pelo Prisma.
# Em dev (docker-compose): postgresql://agendaflex:agendaflex@localhost:5433/agendaflex
# Em prod: ajuste host/porta/credenciais.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agendaflex"

# ─── Auth ──────────────────────────────────────────────────────────
# Segredo para assinar o JWT de sessão (HS256). MÍNIMO 32 chars aleatórios.
# Gere com: openssl rand -hex 32
# Sem isso definido em produção, o servidor LANÇA na primeira request.
AUTH_SECRET=""

# ─── URL pública da aplicação ──────────────────────────────────────
# Base absoluta usada em links gerados no backend (redefinição de senha,
# link público de agendamento). Em prod: https://marcaiflex.com.br
# Se ausente, o fluxo de reset cai para a origem da requisição.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── E-mail transacional (Resend) ──────────────────────────────────
# API key do Resend (re_...). Sem ela, sendEmail apenas loga (modo dev).
RESEND_API_KEY=""
# Remetente verificado no Resend (ex.: noreply@seudominio.com.br).
RESEND_FROM_EMAIL="noreply@marcaiflex.com.br"

# ─── Login social (Google OAuth 2.0) ───────────────────────────────
# Credenciais do OAuth client (Google Cloud Console → APIs e Serviços →
# Credenciais). Sem as três definidas, o botão "Continuar com Google"
# redireciona para /login?error=oauth_unavailable (degrada sem quebrar).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Precisa bater EXATAMENTE com um "URI de redirecionamento autorizado" no
# console. Prod: https://marcaiflex.com.br/api/auth/google/callback
# Dev:  http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ─── Mercado Pago (gateway de pagamento) ───────────────────────────
# Access token do MP (APP_USR-... em produção, TEST-... em sandbox).
MP_ACCESS_TOKEN=""
# Segredo configurado no painel do MP — usado para validar o header
# x-signature em /api/webhooks/mercadopago.
MP_WEBHOOK_SECRET=""
# URL absoluta para a qual o MP redireciona o cliente após autorizar
# ou cancelar a assinatura (ex.: https://app.seudominio.com/assinatura).
MP_BACK_URL=""

# ─── Bot WhatsApp (WuzAPI) ─────────────────────────────────────────
# WuzAPI auto-hospedada (baseada em whatsmeow) que envia/recebe mensagens e
# gera o QR Code diretamente via GET /session/qr. Em dev: http://localhost:8080
WUZAPI_URL="http://localhost:8080"
# Token admin global da WuzAPI (header Authorization nas rotas /admin/*).
WUZAPI_ADMIN_TOKEN=""
# Opcional: se definido, valida o header x-webhook-token nos webhooks recebidos.
# A WuzAPI NÃO envia esse header por padrão — deixe vazio para aceitar sem token.
WHATSAPP_WEBHOOK_TOKEN=""
#
# Legado (Evolution API) — não é mais usado pelo bot. Mantido apenas porque o
# painel Master de saúde ainda consulta este endpoint; remova quando migrar.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# ─── NFE.io (emissão de NFS-e) ─────────────────────────────────────
# UMA conta NFE.io para todos os clientes Pro/Max. Cada empresa cliente é
# cadastrada como uma "company" nessa conta e o id fica em
# CompanyInvoiceConfig.nfeioCompanyId. Sem a chave, a emissão automática
# fica desativada e a UI orienta a emissão manual.
NFE_IO_API_KEY=""
NFE_IO_BASE_URL="https://api.nfe.io/v1"
